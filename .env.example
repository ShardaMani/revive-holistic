# Copy this file to .env.local and update with your actual values

# Next.js Public Environment Variables
NEXT_PUBLIC_SITE_URL=https://reviveholistic.in
NEXT_PUBLIC_BUSINESS_NAME=Revive Holistic Wellness Centre
NEXT_PUBLIC_BUSINESS_PHONE=+91 9818515259
NEXT_PUBLIC_BUSINESS_EMAIL=reviveholisticwellnesscentre@gmail.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# API Endpoints (if using backend)
NEXT_PUBLIC_API_URL=

# Email Service Configuration (optional)
# For Formspree
FORMSPREE_FORM_ID=

# For EmailJS
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Private Environment Variables
# Add any private keys or secrets here (not exposed to client)
API_SECRET_KEY=
